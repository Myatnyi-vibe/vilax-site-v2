---
// Настоящая 404 (nginx error_page 404 /404.html). Вид — прототип «404»: «404» моноширинным, заголовок, текст, кнопка.
import Base from '../layouts/Base.astro';
import T from '../components/T.astro';
import { ui } from '../i18n';
import { tone, url } from '../lib/site';
---

<Base page="404" path={url('/404')} titles={{ ru: `404 · ${ui('ru').notFound.title}`, en: `404 · ${ui('en').notFound.title}` }} noindex>
  <section class="nf" {...tone('hero')} data-screen-label="404">
    <div class="wrap nf__in">
      <span class="nf__code" aria-hidden="true">404</span>
      <h1 class="nf__h1"><T get={(_, u) => u.notFound.title} /></h1>
      <p class="nf__p"><T get={(_, u) => u.notFound.text} /></p>
      <a href={url('/')} class="nf__btn"><T get={(_, u) => u.notFound.back} /></a>
    </div>
  </section>
</Base>

<style>
  .nf {
    min-height: 86vh;
    display: flex;
    align-items: center;
    padding: 140px 0 120px;
  }
  .nf__in {
    width: 100%;
    display: flex;
    flex-direction: column;
    gap: 20px;
    align-items: flex-start;
  }
  .nf__code {
    font-family: 'JetBrains Mono', monospace;
    font-weight: 200;
    font-size: clamp(96px, 16vw, 220px);
    line-height: 0.9;
    letter-spacing: -0.04em;
    color: var(--subtle);
  }
  .nf__h1 {
    font-size: clamp(36px, 4.4vw, 64px);
    font-weight: 620;
    line-height: 1.06;
    letter-spacing: -0.03em;
  }
  .nf__p {
    font-size: 18px;
    color: var(--muted);
  }
  .nf__btn {
    display: inline-flex;
    align-items: center;
    height: 48px;
    padding: 0 22px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--onAccent);
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    margin-top: 8px;
  }
</style>
