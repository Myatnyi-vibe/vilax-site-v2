---
// «Как подключаем» (прототип «Onboarding»): H2, 3D-лента (только ≥ 768), пять шагов. Карточку «Что входит в стандартный
// онбординг» Данил велел убрать с сайта (14.10.2026) — секция заканчивается на шагах.
import T from '../T.astro';
import { siteOf } from '../../lib/content';
import { tone, VARIANTS } from '../../lib/site';

const steps = siteOf(VARIANTS[0]).onboarding.steps.map((_, i) => i);
const last = steps.length - 1;
---

<section id="onboarding" class="ob sheet pad" {...tone('onboarding')} data-screen-label="Onboarding">
  <div class="wrap ob__out">
    <h2 data-reveal class="h2"><T get={(s) => s.onboarding.title} /></h2>
    <div data-vlx3d="onboarding" aria-hidden="true" class="ob__slot"></div>
    <ol class="ob__steps">
      {
        steps.map((i) => (
          <li data-reveal class:list={['ob__step', { 'ob__step--last': i === last }]}>
            <h3 class="ob__h3">
              <T get={(s) => s.onboarding.steps[i].title} />
            </h3>
            <p class="ob__p">
              <T get={(s) => s.onboarding.steps[i].text} />
            </p>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .ob__out {
    display: flex;
    flex-direction: column;
    gap: clamp(24px, 3vw, 40px);
  }
  .ob__slot {
    height: clamp(150px, 15vw, 220px);
    width: 100%;
  }
  @media (max-width: 767.98px) {
    .ob__slot {
      display: none;
    }
  }
  .ob__steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));
    gap: clamp(20px, 2vw, 32px);
  }
  @media (max-width: 767.98px) {
    .ob__steps {
      grid-template-columns: 1fr;
    }
  }
  /* Планшет-портрет: пять колонок по ~110 px рвали заголовки — шаги 3 + 2 на всю ширину (SITE-42, P1-4) */
  @media (min-width: 768px) and (max-width: 1023.98px) {
    .ob__steps {
      grid-template-columns: repeat(6, minmax(0, 1fr));
      row-gap: 32px;
    }
    .ob__step {
      grid-column: span 2;
    }
    .ob__step:nth-child(n + 4) {
      grid-column: span 3;
    }
  }
  .ob__step {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding-top: 20px;
    border-top: 1px solid var(--hairS);
  }
  .ob__step--last {
    border-top: 2px solid var(--accent);
  }
  .ob__h3 {
    font-size: 20px;
    font-weight: 600;
    letter-spacing: -0.01em;
    line-height: 1.3;
  }
  .ob__p {
    font-size: 15px;
    color: var(--muted);
  }
</style>
